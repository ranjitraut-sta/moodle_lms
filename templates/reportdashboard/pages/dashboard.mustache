<div class="row g-4 mt-4">
    <!-- Total Courses Card -->
    <div class="col-12 col-sm-6 col-md-6 col-xl-3">
        <div class="amd-lms-user-dash-card shadow-sm border-0 bg-primary text-white">
            <div class="amd-lms-user-dash-card-body p-3">
                <p class="mb-1 opacity-75">Total Courses</p>
                <h3 class="fw-bold">{{total_courses}}</h3>
                <p class="mb-0 small text-white-50">Active in system</p>
                <i class="fa fa-book amd-lms-user-dash-stat-icon text-white opacity-25" style="position: absolute; right: 15px; top: 20px; font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <!-- Total Users Card -->
    <div class="col-12 col-sm-6 col-md-6 col-xl-3">
        <div class="amd-lms-user-dash-card shadow-sm border-0 bg-success text-white">
            <div class="amd-lms-user-dash-card-body p-3">
                <p class="mb-1 opacity-75">Total Users</p>
                <h3 class="fw-bold">{{total_users}}</h3>
                <p class="mb-0 small text-white-50">Registered students</p>
                <i class="fa fa-users amd-lms-user-dash-stat-icon text-white opacity-25" style="position: absolute; right: 15px; top: 20px; font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <!-- Total Enrollment Card -->
    <div class="col-12 col-sm-6 col-md-6 col-xl-3">
        <div class="amd-lms-user-dash-card shadow-sm border-0 bg-info text-white">
            <div class="amd-lms-user-dash-card-body p-3">
                <p class="mb-1 opacity-75">Total Enrollments</p>
                <h3 class="fw-bold">{{total_enrollments}}</h3>
                <p class="mb-0 small text-white-50">Across all courses</p>
                <i class="fa fa-id-card amd-lms-user-dash-stat-icon text-white opacity-25" style="position: absolute; right: 15px; top: 20px; font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <!-- Active Users Today Card -->
    <div class="col-12 col-sm-6 col-md-6 col-xl-3">
        <div class="amd-lms-user-dash-card shadow-sm border-0 bg-dark text-white">
            <div class="amd-lms-user-dash-card-body p-3">
                <p class="mb-1 opacity-75">Active Users Today</p>
                <h3 class="fw-bold">{{active_users_today}}</h3>
                <p class="mb-0 small text-white-50">Today Login User Count</p>
                <i class="fa fa-user-times amd-lms-user-dash-stat-icon text-white opacity-25" style="position: absolute; right: 15px; top: 20px; font-size: 2rem;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <!-- Active Users (Line Chart) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-3">
            <h6 class="fw-bold mb-3 small">Number of Active Users per Day (Last 30 Days)</h6>
            <div style="height: 300px;"><canvas id="activeUsersChart"></canvas></div>
        </div>
    </div>

    <!-- Top Enrolled Courses (Bar/Doughnut Chart) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-3 h-100">
            <h6 class="fw-bold mb-3 small">Enrollments by Course</h6>
            <div style="height: 300px;"><canvas id="enrollmentChart"></canvas></div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // 1. Active Users Line Chart
    const activeCtx = document.getElementById('activeUsersChart').getContext('2d');
    new Chart(activeCtx, {
        type: 'line',
        data: {
            labels: [{{#active_users_chart.labels}}"{{.}}",{{/active_users_chart.labels}}],
            datasets: [{
                label: 'Active Users',
                data: [{{#active_users_chart.data}}{{.}},{{/active_users_chart.data}}],
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                fill: true,
                tension: 0.3,
                pointRadius: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { display: false },
                    ticks: {
                        precision: 0,
                        stepSize: 1
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: {
                        maxRotation: 45,
                        minRotation: 45
                    }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });

    // 2. Enrollment Distribution Chart
    const enrollCtx = document.getElementById('enrollmentChart').getContext('2d');
    new Chart(enrollCtx, {
        type: 'doughnut',
        data: {
            labels: [{{#enrollment_chart.labels}}"{{.}}",{{/enrollment_chart.labels}}],
            datasets: [{
                data: [{{#enrollment_chart.data}}{{.}},{{/enrollment_chart.data}}],
                backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#0dcaf0', '#6610f2'],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
            }
        }
    });
});
</script>