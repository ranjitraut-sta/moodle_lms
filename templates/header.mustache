<!-- ================= PRELOADER ================= -->
<div class="amd-lms-hero-preloader d-none" id="preloader">
    <div class="preloader-text">LMS Management</div>
</div>

<header class="amd-lms-header" id="mainHeader">
    <!-- ================= TOPBAR ================= -->
    <div class="amd-lms-topbar d-none d-lg-flex justify-content-between align-items-center">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- SOCIAL LINKS -->
            <div class="amd-lms-topbar-social d-flex align-items-center gap-3">
                {{#setting.facebook}}<a href="{{{setting.facebook}}}" target="_blank"><i class="fab fa-facebook-f"></i></a>{{/setting.facebook}}
                {{#setting.twitter}}<a href="{{{setting.twitter}}}" target="_blank"><i class="fab fa-twitter"></i></a>{{/setting.twitter}}
                {{#setting.instagram}}<a href="{{{setting.instagram}}}" target="_blank"><i class="fab fa-instagram"></i></a>{{/setting.instagram}}
                {{#setting.linkedin}}<a href="{{{setting.linkedin}}}" target="_blank"><i class="fab fa-linkedin-in"></i></a>{{/setting.linkedin}}
            </div>

            <!-- RIGHT SIDE (Profile Dropdown) -->
            <div class="d-flex align-items-center gap-3">
                {{#setting.isloggedin}}
                <div class="amd-lms-user-dash-profile dropdown" id="userProfileWrapper">
                    <div class="d-flex align-items-center profile-trigger" role="button" id="profileClickArea">
                        {{#setting.userpicture}}
                            <img src="{{setting.userpicture}}" width="35" height="35" class="rounded-circle me-2" alt="profile">
                        {{/setting.userpicture}}
                        {{^setting.userpicture}}
                            <div class="rounded-circle me-2 d-flex align-items-center justify-content-center bg-light border" style="width: 35px; height: 35px;">
                                <i class="bi bi-person-fill text-secondary"></i>
                            </div>
                        {{/setting.userpicture}}
                        
                        <div class="amd-lms-user-dash-profile-text d-none d-md-block me-1">
                            <strong class="text-dark mb-0">{{setting.username}}</strong>
                        </div>
                        <i class="bi bi-chevron-down small text-muted"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" id="userDropdownMenu">
                        <li><a class="dropdown-item py-2 text-dark amd-drop" href="{{setting.dashboardurl}}"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 text-danger amd-drop" href="{{setting.logouturl}}"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                    </ul>
                </div>
                {{/setting.isloggedin}}

                {{^setting.isloggedin}}
                <a href="{{setting.loginurl}}" class="btn btn-sm amd-lms-btn-login">Login</a>
                {{/setting.isloggedin}}
            </div>
        </div>
    </div>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg amd-lms-navbar">
        <div class="container">
            <a class="navbar-brand" href="{{config.wwwroot}}/?redirect=0">
                <img src="{{setting.logo}}" alt="Logo" height="80">
            </a>

            <button class="navbar-toggler" type="button" id="mobileMenuBtn">
                <i class="fa fa-bars"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{config.wwwroot}}/?redirect=0"><i class="fas fa-home me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{config.wwwroot}}/theme/mytheme/pages/courselist.php">My Courses</a>
                    </li>
                </ul>

                <div class="d-lg-none mt-3 border-top pt-3">
                    {{#setting.isloggedin}}
                        <a class="btn btn-danger w-100 mb-2" href="{{setting.logouturl}}">Logout</a>
                    {{/setting.isloggedin}}
                    {{^setting.isloggedin}}
                        <a class="btn btn-primary w-100 mb-2" href="{{setting.loginurl}}">Login</a>
                    {{/setting.isloggedin}}
                </div>

                <div class="d-none d-lg-block">
                    <a href="{{setting.contacturl}}" class="btn amd-lms-btn-register">Contact : 6630187</a>
                </div>
            </div>
        </div>
    </nav>
</header>

<style>
/* Dropdown Display Fix */
.dropdown-menu {
    display: none;
    position: absolute;
    z-index: 9999;
    min-width: 200px;
    background-color: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
    border: none;
    right: 0; /* Align to right */
}

.dropdown-menu.show {
    display: block !important;
}

.amd-lms-user-dash-profile {
    position: relative;
    padding: 5px 12px;
    border-radius: 50px;
    background: #f8f9fa;
    cursor: pointer;
    border: 1px solid #eee;
}

.amd-drop:hover {
    background-color: #f0f7ff !important;
    color: #000000 !important;
}

.dropdown-item:hover.text-dark, .dropdown-item:hover a.text-dark, .dropdown-item:focus.text-dark, .dropdown-item:focus a.text-dark {
    color: #000000 !important;
}
.dropdown-item:hover.text-danger, .dropdown-item:hover a.text-danger, .dropdown-item:focus.text-danger, .dropdown-item:focus a.text-danger {
   color: #000000 !important;
}
/* Mobile Nav Fix */
#mainNav.show {
    display: block !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // 1. Profile Dropdown Logic
    const profileTrigger = document.getElementById('profileClickArea');
    const dropdownMenu = document.getElementById('userDropdownMenu');

    if (profileTrigger && dropdownMenu) {
        profileTrigger.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation(); // Very important: clicks lai document ma pugna rokne
            dropdownMenu.classList.toggle('show');
        });
    }

    // 2. Mobile Menu Logic
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mainNav = document.getElementById('mainNav');

    if (mobileBtn && mainNav) {
        mobileBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            mainNav.classList.toggle('show');
        });
    }

    // 3. Global Click: Dropdown wa Mobile menu bahira click garda banda garne
    document.addEventListener('click', function (e) {
        // Profile dropdown banda garne
        if (dropdownMenu && !dropdownMenu.contains(e.target) && !profileTrigger.contains(e.target)) {
            dropdownMenu.classList.remove('show');
        }
        
        // Mobile menu banda garne
        if (mainNav && !mainNav.contains(e.target) && !mobileBtn.contains(e.target)) {
            mainNav.classList.remove('show');
        }
    });
});
</script>