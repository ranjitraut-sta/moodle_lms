<!-- Head section vitra yo thapnus (CDN version temporary testing ko lagi) -->
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>

<script>
// forum.js ma thapnus
document.addEventListener('DOMContentLoaded', function() {
    // Dropdown manual trigger
    var dropdownElementList = [].slice.call(document.querySelectorAll('[data-bs-toggle="dropdown"]'))
    var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
        return new bootstrap.Dropdown(dropdownToggleEl)
    });
    
    // Navbar toggler (Mobile ko lagi)
    var navbarToggler = document.querySelector('.navbar-toggler');
    if (navbarToggler) {
        navbarToggler.addEventListener('click', function () {
            var target = document.querySelector(this.getAttribute('data-bs-target'));
            if (target) {
                target.classList.toggle('show');
            }
        });
    }
});
</script>
<!-- ================= JAVASCRIPT ================= -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mainNav = document.getElementById('mainNav');

    // १. मोबाइल मेनु टगल
    if (mobileBtn && mainNav) {
        mobileBtn.addEventListener('click', function () {
            mainNav.classList.toggle('show');
        });
    }

    // २. ड्रपडाउन टगल (Profile & My Courses)
    document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            
            const parent = this.closest('.dropdown');
            const menu = parent.querySelector('.dropdown-menu');
            
            // अरु सबै खुला ड्रपडाउन बन्द गर्ने
            document.querySelectorAll('.dropdown-menu.show').forEach(m => {
                if (m !== menu) m.classList.remove('show');
            });

            menu.classList.toggle('show');
        });
    });

    // ३. बाहिर क्लिक गर्दा सबै बन्द गर्ने
    document.addEventListener('click', function (e) {
        // ड्रपडाउन बन्द गर्ने
        if (!e.target.closest('.dropdown')) {
            document.querySelectorAll('.dropdown-menu.show').forEach(m => m.classList.remove('show'));
        }
        // मोबाइल मेनु बाहिर क्लिक गर्दा बन्द गर्ने
        if (mainNav && !mainNav.contains(e.target) && !mobileBtn.contains(e.target)) {
            mainNav.classList.remove('show');
        }
    });
});
</script>