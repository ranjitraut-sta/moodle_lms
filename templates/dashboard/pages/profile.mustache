<!-- Custom Styling -->
<style>
    /* Tab Management Fixes */
    .amd-tab-pane {
        display: none !important;
    }
    .amd-tab-pane.active-pane {
        display: block !important;
        animation: fadeInTab 0.3s ease-in-out;
    }
    @keyframes fadeInTab {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Core Visual Tokens */
    .bg-light-soft { background-color: #f8fafc !important; }
    .bg-glass { background: rgba(255, 255, 255, 0.12) !important; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    .border-glass { border-color: rgba(255, 255, 255, 0.25) !important; }
    .border-glass-subtle { border-color: rgba(255, 255, 255, 0.15) !important; }
    .text-dark-smooth { color: #334155 !important; }
    .font-xs { font-size: 11px !important; letter-spacing: 0.5px; }
    .fw-extrabold { font-weight: 800 !important; }
    
    .dashboard-hero-card {
        border-radius: 1.25rem !important;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08) !important;
    }
    
    .profile-modern-tabs .nav-link {
        color: rgba(255, 255, 255, 0.7) !important;
        border-bottom: 3px solid transparent !important;
        transition: all 0.2s ease;
    }
    .profile-modern-tabs .nav-link:hover {
        color: #fff !important;
    }
    .profile-modern-tabs .nav-link.active {
        color: #38bdf8 !important;
        border-bottom: 3px solid #38bdf8 !important;
    }
    
    .icon-circle-box {
        width: 32px;
        height: 32px;
        background: #f1f5f9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }
    .grid-info-box {
        background-color: #fcfdfe !important;
        border-color: #e2e8f0 !important;
    }
