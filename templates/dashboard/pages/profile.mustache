<!-- ⚡ Pure Native JavaScript Engine for Tab Switching -->
<script>
function switchAmdTab(evt, paneId) {
    // 1. All tab content templates hide garne
    var panes = document.getElementsByClassName("amd-tab-pane");
    for (var i = 0; i < panes.length; i++) {
        panes[i].classList.remove("active-pane");
    }

    // 2. All tab indicators bata 'active' class hatayera standard text style rakhne
    var links = document.querySelectorAll(".profile-modern-tabs .nav-link");
    for (var j = 0; j < links.length; j++) {
        links[j].classList.remove("active");
    }

    // 3. Clicked dynamic element lai activate garne
    document.getElementById(paneId).classList.add("active-pane");
    evt.currentTarget.classList.add("active");
}
</script>



<!-- Profile Update AJAX Handler -->
<script>
function showStatusMessage(elementId, message, isSuccess) {
    const statusDiv = document.getElementById(elementId);
    statusDiv.innerHTML = `
        <div class="alert alert-${isSuccess ? 'success' : 'danger'} alert-dismissible fade show rounded-3" role="alert">
            <i class="fas fa-${isSuccess ? 'check-circle' : 'exclamation-circle'} me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    `;
    
    if (isSuccess) {
        setTimeout(() => {
            statusDiv.innerHTML = '';
        }, 5000);
    }
}

// Handle Profile Update Form
const profileForm = document.getElementById('profileUpdateForm');
if (profileForm) {
    profileForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const ajaxUrl = '{{config.wwwroot}}/theme/mytheme/pages/profile_ajax.php';
        
        // Add loading state
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
        
        // Ensure sesskey is present; prefer the hidden input, fall back to Moodle's JS config
        if (!formData.get('sesskey')) {
            var sessFromM = (window.M && M.cfg && M.cfg.sesskey) ? M.cfg.sesskey : null;
            var hidden = document.querySelector('input[name="sesskey"]');
            var sess = sessFromM || (hidden ? hidden.value : null);
            if (sess) formData.set('sesskey', sess);
        }

        fetch(ajaxUrl, {
            method: 'POST',
            body: formData,
            credentials: 'same-origin'
        })
        .then(response => {
            // Accept both 200 and 400 - we check the JSON response for actual status
            return response.text().then(text => ({
                status: response.status,
                text: text
            }));
        })
        .then(({status, text}) => {
            try {
                const data = JSON.parse(text);
                console.log('Response:', {status, data});
                showStatusMessage('profileUpdateStatus', data.message, data.success);
                if (data.success) {
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                }
            } catch (e) {
                console.error('Invalid JSON response:', text);
                showStatusMessage('profileUpdateStatus', 'Server returned an invalid response. Please refresh and try again.', false);
            }
        })
        .catch(error => {
            console.error('Fetch error:', error);
            showStatusMessage('profileUpdateStatus', 'An error occurred: ' + error.message, false);
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
    });
}

// Handle Credentials Update Form
const credentialsForm = document.getElementById('credentialsForm');
if (credentialsForm) {
    credentialsForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const ajaxUrl = '{{config.wwwroot}}/theme/mytheme/pages/profile_ajax.php';
        
        // Add loading state
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
        
        fetch(ajaxUrl, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            // Accept both 200 and 400 - we check the JSON response for actual status
            return response.text().then(text => ({
                status: response.status,
                text: text
            }));
        })
        .then(({status, text}) => {
            try {
                const data = JSON.parse(text);
                console.log('Response:', {status, data});
                showStatusMessage('credentialsUpdateStatus', data.message, data.success);
                if (data.success) {
                    document.querySelector('input[name="current_password"]').value = '';
                    document.querySelector('input[name="new_password"]').value = '';
                }
            } catch (e) {
                console.error('Invalid JSON response:', text);
                showStatusMessage('credentialsUpdateStatus', 'Server returned an invalid response. Please refresh and try again.', false);
            }
        })
        .catch(error => {
            console.error('Fetch error:', error);
            showStatusMessage('credentialsUpdateStatus', 'An error occurred: ' + error.message, false);
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
    });
}
</script>
