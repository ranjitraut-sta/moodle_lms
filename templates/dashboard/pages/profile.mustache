<main class="amd-lms-user-dash-main-content p-4">
    <div class="container-fluid">
        <!-- 🚀 Profile Header Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-body p-0">
                <!-- Cover Background with Gradient -->
                <div class="amd-profile-bg" style="height: 140px; background: linear-gradient(45deg, #1e293b, #334155);"></div>
                
                <div class="px-4 pb-4 mt-n5">
                    <div class="d-flex align-items-end flex-wrap">
                        <!-- Profile Icon Placeholder -->
                        <div class="position-relative" style="margin-top: -70px;">
                            <div class="rounded-circle border border-4 border-white shadow-sm d-flex align-items-center justify-content-center bg-white" 
                                 style="width: 140px; height: 140px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                     style="width: 100%; height: 100%; background: #f1f5f9; color: #64748b;">
                                    <!-- Using FontAwesome User Circle Icon -->
                                    <i class="fas fa-user-circle" style="font-size: 132px;"></i>
                                </div>
                            </div>
                        </div>

                        <!-- User Identity -->
                        <div class="ms-md-4 mt-3 mt-md-0 mb-2">
                            <h2 class="fw-bold mb-1 text-white me-2">{{fullname}}</h2>
                            <div class="d-flex gap-3 flex-wrap mt-3">
                                {{#email}}
                                <span class="text-dark small"><i class="fas fa-envelope text-danger me-1"></i> {{email}}</span>
                                {{/email}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- 👤 Quick Stats & Account Info -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-shape bg-soft-primary rounded-3 p-2 me-3">
                            <i class="fas fa-shield-alt text-primary"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Account Details</h5>
                    </div>
                    
                    <div class="vstack gap-4">
                        {{#phone}}
                        <div class="d-flex align-items-center">
                            <div class="text-primary me-3" style="width: 20px;"><i class="fas fa-phone-alt"></i></div>
                            <div>
                                <small class="text-muted d-block small fw-bold text-uppercase">Phone Number</small>
                                <span class="fw-medium text-dark">{{phone}}</span>
                            </div>
                        </div>
                        {{/phone}}

                        <div class="d-flex align-items-center">
                            <div class="text-primary me-3" style="width: 20px;"><i class="fas fa-calendar-check"></i></div>
                            <div>
                                <small class="text-muted d-block small fw-bold text-uppercase">Member Since</small>
                                <span class="fw-medium text-dark">{{joined_on}}</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="text-primary me-3" style="width: 20px;"><i class="fas fa-clock"></i></div>
                            <div>
                                <small class="text-muted d-block small fw-bold text-uppercase">Last Activity</small>
                                <span class="fw-medium text-primary">{{last_access}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 📄 Professional & Personal Info -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                        <div class="icon-shape bg-soft-info rounded-3 p-2 me-3">
                            <i class="fas fa-briefcase text-info"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Professional Information</h5>
                    </div>
                    
                    <div class="row g-4">
                        {{#organization_name}}
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Organization</label>
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <i class="fas fa-university me-2 text-muted"></i>{{organization_name}}
                            </div>
                        </div>
                        {{/organization_name}}

                        {{#designation}}
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Designation</label>
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <i class="fas fa-id-badge me-2 text-muted"></i>{{designation}}
                            </div>
                        </div>
                        {{/designation}}

                        {{#pan_no}}
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1 d-block">PAN / VAT</label>
                            <div class="p-3 border rounded-3 bg-light-subtle">{{pan_no}}</div>
                        </div>
                        {{/pan_no}}

                        {{#qualification}}
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Qualification</label>
                            <div class="p-3 border rounded-3 bg-light-subtle">{{qualification}}</div>
                        </div>
                        {{/qualification}}
                    </div>

                    <!-- 📍 Location with FontAwesome -->
                    {{#province}}
                    <div class="mt-5">
                        <h6 class="fw-bold mb-3 d-flex align-items-center">
                            <i class="fas fa-map-marker-alt text-danger me-2"></i>Location Details
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Province</small>
                                    <span class="fw-bold">{{province}}</span>
                                </div>
                            </div>
                            {{#district}}
                            <div class="col-md-4">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">District</small>
                                    <span class="fw-bold">{{district}}</span>
                                </div>
                            </div>
                            {{/district}}
                            {{#municipality}}
                            <div class="col-md-4">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Municipality</small>
                                    <span class="fw-bold">{{municipality}}</span>
                                </div>
                            </div>
                            {{/municipality}}
                        </div>
                    </div>
                    {{/province}}

                    <!-- Empty State -->
                    {{^organization_name}}{{^pan_no}}{{^province}}
                    <div class="text-center py-4">
                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" alt="Empty" style="width: 80px; opacity: 0.5;">
                        <p class="mt-3 text-muted">Aafno profile pura garnu hos.</p>
                    </div>
                    {{/province}}{{/pan_no}}{{/organization_name}}
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .bg-soft-primary { background-color: #e0e7ff; }
    .bg-soft-info { background-color: #e0f2fe; }
    .bg-light-subtle { background-color: #f8fafc; }
    .mt-n5 { margin-top: -3rem !important; }
    .rounded-4 { border-radius: 1rem !important; }
    .text-dark { color: #1e293b !important; }
</style>