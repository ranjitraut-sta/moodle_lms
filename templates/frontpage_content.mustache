<main>

<!-- About Section -->
<section class="amd-lms-about amd-shine-bg">
    <div class="container">
        <div class="amd-lms-about-section">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="amd-lms-about-section-image-wrapper">
                    <svg class="amd-lms-about__deco-wavy-line" viewBox="0 0 137 106" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M135.5 1.5C124.7 11.5 106.833 30.5 87.5 27C59.5 22 28.5 4.5 1.5 35.5C-25.5 66.5 48.1667 115.833 87.5 97.5C126.833 79.1667 151 53 135.5 27C125.1 8.6 112.5 1.5 112.5 1.5" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                                <svg class="amd-lms-about__deco-dot-grid" viewBox="0 0 85 85" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="2.5" cy="2.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="2.5" cy="22.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="2.5" cy="42.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="2.5" cy="62.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="2.5" cy="82.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="22.5" cy="2.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="22.5" cy="22.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="22.5" cy="42.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="22.5" cy="62.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="22.5" cy="82.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="42.5" cy="2.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="42.5" cy="22.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="42.5" cy="42.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="42.5" cy="62.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="42.5" cy="82.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="62.5" cy="2.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="62.5" cy="22.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="62.5" cy="42.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="62.5" cy="62.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="62.5" cy="82.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="82.5" cy="2.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="82.5" cy="22.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="82.5" cy="42.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="82.5" cy="62.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                    <circle cx="82.5" cy="82.5" r="2.5" fill="#ef4444" fill-opacity="0.5"></circle>
                                </svg>
                        {{#about.imageurl}}
                            <img src="{{{about.imageurl}}}" alt="Learning" class="amd-lms-about-section-image">
                        {{/about.imageurl}}
                        {{^about.imageurl}}
                            <img src="{{{config.wwwroot}}}/theme/mytheme/asset/imgs/Cream Yellow Illustrative Self-Help Book Cover.jpg" alt="Learning" class="amd-lms-about-section-image">
                        {{/about.imageurl}}

                        <div class="amd-lms-about__tutor-card">
                                    <img src="{{about.tutorimage}}" alt="Globe Icon" class="amd-lms-about__tutor-card-icon">
                                    <div>
                                        <h6 class="amd-lms-about__tutor-card-title">{{about.tutortitle}}</h6>
                                        <p class="amd-lms-about__tutor-card-desc">{{about.tutordesc}}.</p>
                                    </div>
                                </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="amd-lms-about-section-content">
                        <h6 class="amd-lms-about__pre-title">{{about.tagline}}</h6>
                        <h1 class="amd-lms-about__title">{{about.heading}}</h1>
                        <p class="amd-lms-about__description">{{{about.desc}}}</p>

                                <!-- Bootstrap Carousel -->
                                <div id="courseCarousel" class="carousel slide" data-bs-ride="carousel">

                                    <!-- Indicators -->
                                    {{#aboutCourses.1}}
                                    <div class="carousel-indicators">
                                        <button type="button" data-bs-target="#courseCarousel" data-bs-slide-to="0"
                                            class="active"></button>
                                        <button type="button" data-bs-target="#courseCarousel"
                                            data-bs-slide-to="1"></button>
                                    </div>
                                    {{/aboutCourses.1}}


                                    <!-- Carousel Inner -->
                                    <div class="carousel-inner">

                                        <!-- Slide 1 -->
                                        {{#aboutCourses}}
                                        <div class="carousel-item active">
                                            <div class="d-flex gap-3">

                                                <a href="{{{url}}}"
                                                    class="amd-lms-small-cards d-flex align-items-center p-2 text-decoration-none">

                                                    <!-- Left Image -->
                                                    <div class="amd-lms-card-img">
                                                        <img src="{{{image}}}"
                                                            alt="{{fullname}}" />
                                                    </div>

                                                    <!-- Right Content -->
                                                    <div class="amd-lms-card-content ms-3">
                                                        <h6 class="mb-1 fw-semibold">{{fullname}}</h6>

                                                        <div class="amd-lms-meta d-flex gap-2 flex-wrap">
                                                            <span> <i class="bi bi-person"></i> {{enrolledcount}}</span>
                                                            <span class="text-white">{{category}}</span>
                                                        </div>
                                                    </div>

                                                </a>
                                            </div>
                                        </div>
                                        {{/aboutCourses}}

                                    </div>
                                </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="amd-lms-about__achievements">
            <div class="amd-lms-about__achievements-card">
                <h5 class="amd-lms-about__achievements-title">{{about.statheading}}</h5>
                <div class="row">
                    {{#about.stats}}
                    <div class="col-md-4">
                        <div class="amd-lms-about__stat">
                            <h2 class="amd-lms-about__stat-number">{{number}}</h2>
                            <p class="amd-lms-about__stat-description">{{{description}}}</p>
                        </div>
                    </div>
                    {{/about.stats}}
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Course Section -->
<section class="amd-lms-course-section" id="course-section">
    <div class="container">
        <div class="amd-lms-course-section__header d-lg-flex justify-content-between align-items-center">
            <div class="amd-lms-text-wrap">
                <h2 class="amd-lms-course-section__title">Our Courses</h2>
            </div>
            <div class="amd-lms-course-section__filters mt-4 mt-lg-0">
                <a href="{{config.wwwroot}}/theme/mytheme/pages/courselist.php" class="dropdown">
                    <button type="button" class="amd-lms-btn-register">View All <i class="fas fa-arrow-right"></i></button>
                </a>
            </div>
        </div>

        <div class="row g-4 amd-lms-course-section__grid">
            {{#courses}}
            <div class="col-lg-4 col-md-6 amd-lms-course-section__grid-item">
                <div class="amd-lms-course-section__card">
                    <a href="{{{url}}}">
                        <div class="amd-lms-course-section__card-image-wrapper">
                            <img src="{{{image}}}" alt="{{fullname}}">
                            <span class="amd-lms-course-section__card-category">{{category}}</span>
                        </div>
                        <div class="amd-lms-course-section__card-body">
                            <a href="{{{url}}}" class="amd-lms-course-section__card-title text-decoration-none">{{fullname}}</a>
                        </div>
                    </a>
                </div>
            </div>
            {{/courses}}
            {{^courses}}
            <div class="col-12">
                <p class="text-center">No courses available at the moment.</p>
            </div>
            {{/courses}}
        </div>
    </div>
</section>
    
</main>
