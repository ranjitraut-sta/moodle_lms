<div class="amd-app-wrap" role="application">
    {{! Left Sidebar }}
  <nav class="amdcoursesidebar" id="amdcoursesidebar" aria-label="Course navigation" role="navigation" tabindex="0">
        <div class="amd-course-brand" tabindex="0" aria-label="Course title">
            <a href="{{config.wwwroot}}/?redirect=0" class="logo amd-lms-tooltip" aria-hidden="true" data-bs-toggle="tooltip"
                data-bs-placement="right" title="Home">
                <i class="fas fa-home"></i>
            </a>
            <div class="amd-course-brand-text">{{coursename}}</div>
            <button id="amdcoursesidebarToggle" aria-label="Collapse sidebar" aria-expanded="true"
                class="btn btn-sm btn-outline-light ms-auto amd-lms-tooltip" data-bs-toggle="tooltip"
                data-bs-placement="left" title="Close sidebar">
                <i class="ri-arrow-left-s-line"></i>
            </button>
        </div>

        <div class="amdcoursesidebar-inner" tabindex="0">
            {{#sections}}
            <section class="amd-course-chapter">
                <div class="amd-course-chapter-header expanded" aria-expanded="true" role="button" tabindex="0" aria-controls="chapter-list-{{id}}">
                    <span class="text-label">{{name}}</span>
                    <i class="ri-arrow-down-s-line"></i>
                </div>
                <ul id="chapter-list-{{id}}" class="amd-course-lessons-list expanded">
                    {{#modules}}
                    <a href="{{url}}" class="lesson {{#active}}active{{/active}} {{#locked}}amd-lesson-locked{{/locked}}" tabindex="0" title="{{name}}">
                        <span class="number"><i class="bi bi-{{icon}}"></i></span>
                        <span class="text-label">{{name}}</span>
                        {{#completed}}
                        <i class="fa fa-check amd-course-sidebar-icon" aria-hidden="true"></i>
                        {{/completed}}
                        {{^completed}}
                        {{#locked}}
                        <i class="fa fa-lock amd-course-sidebar-icon" aria-hidden="true"></i>
                        {{/locked}}
                        {{^locked}}
                        {{#active}}
                        <i class="fa-solid fa-lock-open amd-course-sidebar-icon"></i>
                        {{/active}}
                        {{^active}}
                        <i class="fa fa-lock-open amd-course-sidebar-icon" aria-hidden="true"></i>
                        {{/active}}
                        {{/locked}}
                        {{/completed}}
                    </a>
                    {{/modules}}
                </ul>
            </section>
            {{/sections}}
        </div>
    </nav>

    {{! Sidebar open button (shown when collapsed) }}
    <button class="amdcoursesidebarOpenBtn btn btn-outline-secondary amd-lms-tooltip" id="amdcoursesidebarOpenBtn"
        data-bs-toggle="tooltip" data-bs-placement="right" title="Open Sidebar">
        <i class="ri-graduation-cap-line"></i>
    </button>

    {{! Main Content }}
    <main class="amd-course-content main-content" role="main">

        <header class="amd-course-header" aria-label="Course details">
            <div class="d-flex align-items-center gap-2">
                <h1>{{coursename}}</h1>
            </div>
            <div>
                <span class="amd-course-tag mx-1 amd-lms-tooltip" title="Back to Course" data-bs-toggle="tooltip"
                    data-bs-placement="left">
                    <a href="{{courseurl}}"><i class="fas fa-arrow-left"></i> Back to Course</a>
                </span>
                <span class="amd-course-tag">{{category}}</span>
            </div>
        </header>

        {{! Lesson description offcanvas }}
        <div class="offcanvas offcanvas-end" tabindex="-1" id="lessonInfoCanvas">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title">{{modulename}}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
                {{> theme_mytheme/module_content }}
            </div>
        </div>

        <div class="amd-lesson-video-area" aria-label="Lesson content area" tabindex="0">

            <button class="amd-course-video-fullscreen-btn amd-lms-tooltip" title="Fullscreen" aria-label="Fullscreen video" data-bs-toggle="tooltip" data-bs-placement="right" style=" ">
                <i class="ri-fullscreen-line" style="font-size: 18px;"></i>
            </button>

            {{! Progress bar }}
            <div class="amd-lesson-top-progress">
            </div>

              {{!  lesson detail attach  }}
            <div class="amd-main-container">
                {{> theme_mytheme/module_content }}
            </div>

        </div>

        {{! Sticky Bottom Navigation }}
        <div class="amd-sticky-btn-bottom">
            <div class="amd-lms-btns-wrap gap-4 d-flex justify-content-end align-items-center"
                role="group"
                aria-label="Lesson navigation buttons">

                {{! ================= PREVIOUS BUTTON ================= }}
                {{#prevmodule}}
                <button class="amd-lms-btn amd-lms-prev-btn"
                    onclick="window.location.href='{{prevmodule.url}}'"
                    aria-label="Previous lesson"
                    title="{{prevmodule.name}}">
                    
                    <span class="amd-lms-icon">
                        <i class="fa-solid fa-arrow-left"></i>
                    </span>

                    <span class="amd-lms-text">
                        Previous
                    </span>
                </button>
                {{/prevmodule}}

                {{! ================= MARK AS DONE ================= }}
                {{#ismanualcompletion}}
                    {{#ismarkedcomplete}}
                    <div class="amd-lms-btn ms-3 amd-lms-prev-btn" style="white-space:nowrap; opacity: 0.8; cursor: default;" title="You have completed this lesson">
                        <span class="amd-lms-text">Completed</span>
                        <span class="amd-lms-icon"><i class="fa-solid fa-circle-check" style="color: #198754;"></i></span>
                    </div>
                    {{/ismarkedcomplete}}
                    {{^ismarkedcomplete}}
                    <a href="{{toggleurl}}" class="amd-lms-btn ms-3 amd-lms-next-btn" style="white-space:nowrap; text-decoration: none;" title="Mark this lesson as done">
                        <span class="amd-lms-text">Mark as done</span>
                        <span class="amd-lms-icon"><i class="fa-regular fa-circle"></i></span>
                    </a>
                    {{/ismarkedcomplete}}
                {{/ismanualcompletion}}


                {{! ================= NEXT LESSON ================= }}
                {{#nextmodule}}
                {{^islastlesson}}

                    {{#nextmodule.locked}}
                    <button class="amd-lms-btn amd-lms-next-btn"
                        disabled
                        title="Complete this lesson first">

                        <span class="amd-lms-text">
                            Next
                        </span>

                        <span class="amd-lms-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                    </button>
                    {{/nextmodule.locked}}


                    {{^nextmodule.locked}}
                    <button class="amd-lms-btn amd-lms-next-btn"
                        onclick="window.location.href='{{nextmodule.url}}'"
                        aria-label="Next lesson"
                        title="{{nextmodule.name}}">

                        <span class="amd-lms-text">
                            Next
                        </span>

                        <span class="amd-lms-icon">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </button>
                    {{/nextmodule.locked}}

                {{/islastlesson}}
                {{/nextmodule}}


                {{! ================= LAST LESSON / FINISH COURSE ================= }}
                {{#islastlesson}}
                {{^iscompleted}}

                    {{#nextmodule.locked}}
                    <button class="amd-lms-btn amd-lms-next-btn"
                        disabled
                        title="Complete this lesson first">

                        <span class="amd-lms-text">
                            Finish Course
                        </span>

                        <span class="amd-lms-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                    </button>
                    {{/nextmodule.locked}}


                    {{^nextmodule.locked}}
                    <button class="amd-lms-btn amd-lms-next-btn"
                        onclick="window.location.href='{{nextmodule.url}}'"
                        aria-label="Finish Course">

                        <span class="amd-lms-text">
                            Finish Course
                        </span>

                        <span class="amd-lms-icon">
                            <i class="fa-solid fa-check"></i>
                        </span>
                    </button>
                    {{/nextmodule.locked}}

                {{/iscompleted}}
                {{/islastlesson}}


                {{! ================= CERTIFICATE BUTTON ================= }}
                {{#iscompleted}}
                {{#certurl}}

                <button class="amd-lms-btn amd-lms-next-btn"
                    aria-label="View Certificate">

                    <span class="amd-lms-text">
                       Completed Course
                    </span>

                    <span class="amd-lms-icon">
                        <i class="fa-solid fa-check-circle"></i>
                    </span>
                </button>

                {{/certurl}}
                {{/iscompleted}}

            </div>
        </div>

    </main>
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    // 1. Sidebar Toggle (Open/Close Sidebar itself)
    const sidebar = document.getElementById('amdcoursesidebar');
    const toggleBtn = document.getElementById('amdcoursesidebarToggle');
    const openBtn = document.getElementById('amdcoursesidebarOpenBtn');

    if (toggleBtn && openBtn && sidebar) {
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.add('collapsed');
            openBtn.classList.add('show');
        });

        openBtn.addEventListener('click', () => {
            sidebar.classList.remove('collapsed');
            openBtn.classList.remove('show');
        });
    }

    // 2. Chapter/Section Toggle (Accordion Logic)
    const chapterHeaders = document.querySelectorAll('.amd-course-chapter-header');

    chapterHeaders.forEach(header => {
        header.addEventListener('click', function() {
            const lessonsList = this.nextElementSibling; // .amd-course-lessons-list
            const icon = this.querySelector('.ri-arrow-down-s-line, .ri-arrow-up-s-line');

            // Close other open sections (Optional: Accordion effect)
            document.querySelectorAll('.amd-course-lessons-list').forEach(list => {
                if (list !== lessonsList) {
                    list.classList.remove('expanded');
                    list.previousElementSibling.classList.remove('expanded');
                }
            });

            // Toggle current section
            lessonsList.classList.toggle('expanded');
            this.classList.toggle('expanded');

            // Icon change (yadi class use garnu bhako chha bhane)
            if (lessonsList.classList.contains('expanded')) {
                this.setAttribute('aria-expanded', 'true');
            } else {
                this.setAttribute('aria-expanded', 'false');
            }
        });
    });
});
</script>