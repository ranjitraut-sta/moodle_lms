



    <footer class="amd-lms-footer">
        <!-- The top card that overlaps the black section -->
        <div class="amd-lms-footer-promo-card">
            <div class="amd-lms-footer-promo-card__content">
                   <h1>{{jumbotron.heading}}</h1>
                    <p>{{jumbotron.desc}}</p>
            </div>
        </div>

        <!-- The main black footer area -->
<div class="amd-lms-footer-main">
    <div class="amd-lms-footer-container">
        <!-- Top section with columns -->
        <div class="amd-lms-footer-main__top-grid">
            
            <!-- Opening Hours Column -->
            <div class="amd-lms-footer-main__column">
                <h2>Opening Hours</h2>
                <!-- 🔥 सुधार १: list-unstyled र ps-0 थपेर मार्जिन/प्याडिङ जिरो गरियो -->
                <ul class="list-unstyled ps-0" style="margin: 0; padding: 0;">
                    <li class="border-bottom pb-3 mb-2">
                        <span class="text-decoration-none text-white d-flex align-items-center">
                            <i class="fa-solid fa-clock me-2"></i>{{footer.opening_weekdays}}
                        </span>
                    </li>
                    <li>
                        <span class="text-decoration-none text-white d-flex align-items-center">
                            <!-- पहिलो लिङ्कसँग सिधा एलाइन गराउन घडीको आइकन यहाँ पनि थप्न सकिन्छ, वा खाली छोड्न सक्नुहुन्छ -->
                            <i class="fa-solid fa-clock me-2" style="visibility: hidden;"></i>{{footer.opening_weekends}}
                        </span>
                    </li>
                </ul>
            </div>

            <!-- Contact Us Column -->
            <div class="amd-lms-footer-main__column">
                <h2>Contact Us</h2>
                <!-- 🔥 सुधार २: यहाँ पनि एकदम सुरुबाटै लिस्ट सुरु गराइयो -->
                <ul class="list-unstyled ps-0" style="margin: 0; padding: 0;">
                    <li class="mb-2">
                        <span  class="text-decoration-none text-white d-flex align-items-start">
                            <i class="fa-solid fa-location-dot me-2 mt-1"></i>
                            <span>{{footer.address}}</span>
                        </span>
                    </li>
                    <li class="mb-2">
                        <span class="text-decoration-none text-white d-flex align-items-center">
                            <i class="fa-solid fa-phone me-2"></i>{{footer.phoneno}}
                        </span>
                    </li>
                    <li>
                        <!-- 🔥 सुधार ३: इमेलको आइकन <a> ट्याग भित्र ल्याएर एलाइनमेन्ट मिलाइयो -->
                        <a href="mailto:{{footer.footeremail}}" class="contact-link text-decoration-none text-white d-flex align-items-center">
                            <i class="fas fa-envelope-open me-2"></i>{{footer.footeremail}}
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Supported By Column -->
            <div class="amd-lms-footer-main__column">
                <h2>Supported By</h2>
                <!-- Supported Logos Loop -->
                <div class="amd-lms-topbar-social d-flex align-items-center gap-3 flex-wrap">
                    {{#footer.supported_logos}}
                        <!-- 🔥 सुधार ४: लोगोलाई कन्टेन गराउन फिक्स साइज र अब्जेक्ट फिट दियो -->
                        <img src="{{image}}" alt="Supported Organization" style="max-width: 100px; max-height: 40px; object-fit: contain;">
                    {{/footer.supported_logos}}
                    
                    {{^footer.supported_logos}}
                    {{/footer.supported_logos}}
                </div>
            </div>

        </div>

        <!-- Bottom copyright section -->
        <div class="amd-lms-footer-main__bottom border-top mt-4 pt-3">
            <div class="d-flex align-items-center justify-content-center gap-3 text-center mb-2">
                <!-- 🔥 सुधार ५: फुटर लोगो साइज फिक्स -->
                <img src="{{footer.footerlogo}}" alt="amd-logo" class="amd-lms-footer-main__logo" style="max-height: 40px; object-fit: contain;">

                <p class="mb-0 text-white">
                    Powered By :
                    {{#footer.poweredby_name}}
                        <a href="{{footer.poweredby_url}}" class="text-decoration-none text-white fw-bold">
                            {{footer.poweredby_name}}
                        </a>
                    {{/footer.poweredby_name}}

                    {{^footer.poweredby_name}}
                        <a href="{{footer.poweredby_url}}" class="text-decoration-none text-white fw-bold">
                            A.M.D. Soft and Services Pvt. Ltd.
                        </a>
                    {{/footer.poweredby_name}}
                </p>
            </div>
            <p class="text-center text-white small mb-0">{{footer.footercopyright}} © {{{year}}} All Rights Reserved.</p>
        </div>
    </div>
</div>
    </footer>