<style>
    /* Premium List Row Setup */
    .amd-folder-container {
        max-width: 900px;
        margin: 2rem auto;
    }

    .amd-file-row {
        background: #ffffff;
        border: 1px solid #eef2f5 !important;
        border-radius: 12px !important;
        padding: 14px 20px;
        margin-bottom: 10px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .amd-file-row:hover {
        background-color: #fafbfc;
        border-color: #dbe2e8 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.04);
    }

    /* Left Side: Icon + Name Info */
    .amd-file-left {
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-right: 15px;
    }

    .amd-file-left i {
        font-size: 1.5rem;
        margin-right: 16px;
        flex-shrink: 0;
    }

    .amd-file-title {
        font-weight: 550;
        color: #2d3748;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.95rem;
    }

    /* Right Side: Action Controls */
    .amd-action-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    /* Action Buttons Custom Look */
    .amd-btn-action {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        color: #4a5568;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    /* Eye (Preview) Hover */
    .amd-btn-preview:hover {
        background-color: #e3efff;
        border-color: #bcd7ff;
        color: #0d6efd;
    }

    /* Download Hover */
    .amd-btn-download:hover {
        background-color: #e6f6ec;
        border-color: #c2eed3;
        color: #198754;
    }

    .amd-btn-action i {
        font-size: 1.1rem;
        margin: 0 !important;
    }

    /* Moodle Alert customization */
    .amd-intro-box {
        background: #ffffff;
        border-left: 4px solid #0d6efd;
        border-radius: 4px 12px 12px 4px;
    }
</style>

<div class="amd-folder-container container">
    {{#folderintro}}
    <div class="amd-intro-box alert alert-light shadow-sm py-3 px-4 mb-4">
        {{{folderintro}}}
    </div>
    {{/folderintro}}

    <div class="amd-file-list-wrapper">
        {{#folderfiles}}
        <div class="amd-file-row shadow-sm">
            
            <!-- Left Panel: File Signature and Identity -->
            <div class="amd-file-left">
                {{#ispdf}}
                    <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                {{/ispdf}}
                {{#isimage}}
                    <i class="bi bi-file-earmark-image-fill text-success"></i>
                {{/isimage}}
                {{#isvideo}}
                    <i class="bi bi-file-earmark-play-fill text-primary"></i>
                {{/isvideo}}
                {{#isaudio}}
                    <i class="bi bi-file-earmark-music-fill text-warning"></i>
                {{/isaudio}}
                {{#isother}}
                    <i class="bi bi-file-earmark-fill text-secondary"></i>
                {{/isother}}
                
                <span class="amd-file-title" title="{{filename}}">{{filename}}</span>
            </div>

            <!-- Right Panel: Dual Target Links (Eye + Download) -->
            <div class="amd-action-group">
                <!-- 👁️ View/Preview Button (Opens in New Tab) -->
                <a href="{{fileurl}}" 
                   target="_blank" 
                   class="amd-btn-action amd-btn-preview" 
                   title="Preview File">
                    <i class="bi bi-eye"></i>
                </a>

            <!-- 📥 Direct Download Button (Moodle query string config + HTML5 backup attribute applied) -->
            <a href="{{fileurl}}" 
            class="amd-btn-action amd-btn-download" 
            title="Download File" 
            download="{{filename}}">
                <i class="bi bi-download"></i>
            </a>
            </div>

        </div>
        {{/folderfiles}}
    </div>
</div>